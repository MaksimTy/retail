# Retail Ontology Platform - Environment Variables
# Copy this file to .env and fill in your values

# OpenRouter API Key (required for LLM providers)
OPENROUTER_API_KEY=your_openrouter_api_key_here

# Database Configuration
DUCKDB_PATH=./data/warehouse.duckdb
POSTGRES_DSN=postgresql://user:password@localhost:5432/retail_ontology

# LLM Provider Configuration
DEFAULT_LLM_PROVIDER=openrouter
DEFAULT_LLM_MODEL=anthropic/claude-3.5-sonnet

# OpenRouter Fallback Models (comma-separated)
OPENROUTER_FALLBACK_MODELS=openai/gpt-4o,anthropic/claude-3.5-sonnet,meta-llama/llama-3.1-405b

# API Configuration
API_HOST=0.0.0.0
API_PORT=8000
API_WORKERS=4

# Telegram Bot Configuration
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
TELEGRAM_WEBHOOK_URL=https://your-domain.com/webhook

# Logging Configuration
LOG_LEVEL=INFO
LOG_FORMAT=json

# Observability
PROMETHEUS_PORT=9090
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317